// spec/app/index.md, "Story: Say hello"
// The shell: the greeter of spec/app/index.md, kept in a KeyValueStore by `stored`, which worker.vibe runs in a Durable
// Object over its storage; `visiting` is the same service in the page, on this visitor's own greeter, over the Worker's
// HTTP API (`remote`).
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Greeter, NotAnEvent, Rejected, apply, decodeEvent, decodeState, initial, parseState } from "../gen/app.effect.vibe"
import { Saved } from "./greeter.schema.ts"

const KEY = "greeter", VISITOR = "visitor"

/** The store did not take the greeter, or could not be reached to; it stays as it was. */
export error NotSaved { cause: unknown }

effect function saved() { return KeyValueStore.toSchemaStore(try KeyValueStore.KeyValueStore, Saved) }

/** The stored greeter, or a new one where the store cannot be read or holds nothing the rules call a greeter. */
export effect function load() {
  const found = (try saved()).get(KEY) catch () => Option.none()
  return decodeState(Option.getOrUndefined(found)) catch () => parseState(initial)!
}

/** The greeter as last stored, and the one way to change it. */
export service Greetings {
  /** The greeter now, then every later one. */
  readonly changes: Stream.Stream<Greeter>
  /** `input` may come from anywhere: it is decoded into an event, and the greeter it leads to is stored before it is shown. */
  receive(input: unknown): Greeter!(NotAnEvent | Rejected | NotSaved)
}

/** `Greetings` from the stored greeter, one input at a time. */
export const stored = Layer.effect(Greetings, effect {
  const store = try saved()
  const held = try SubscriptionRef.make(try load())
  return {
    changes: Stream.map(SubscriptionRef.changes(held), (state) => parseState(state)!),
    receive: (input) => SubscriptionRef.modifyEffect(held, effect (current) => {
      const next = try apply(current, try decodeEvent(input))
      try mapError(store.set(KEY, next), (cause) => new NotSaved({ cause }))
      return [next, parseState(next)!] as const
    })
  }
})

/**
 * `Greetings` of the greeter `key` that the Worker at `base` holds (worker.vibe; vibestack/cloudflare, `machineApi`).
 * The Worker decides; this only says what it answered, one input at a time, and shows a greeter only once it is stored.
 */
function remote(base: string, key: string) {
  return Layer.effect(Greetings, effect {
    const client = HttpClient.mapRequest(try HttpClient.HttpClient, HttpClientRequest.prependUrl(base))
    const at = `/api/app/${encodeURIComponent(key)}`
    const unreached = (cause: unknown) => new NotSaved({ cause })
    const held = try SubscriptionRef.make(try mapError(effect { return try decodeState(try (try client.get(at)).json) }, unreached))
    return {
      changes: Stream.map(SubscriptionRef.changes(held), (state) => parseState(state)!),
      receive: (input) => SubscriptionRef.modifyEffect(held, effect (current) => {
        const answer = try mapError(client.execute(try mapError(HttpClientRequest.bodyJson(HttpClientRequest.post(at), input), unreached)), unreached)
        const said = try mapError(answer.json, unreached)
        if (answer.status === 400) throw new NotAnEvent({ input })
        if (answer.status === 409) throw new Rejected({ event: try decodeEvent(input), state: current })
        if (answer.status !== 200) throw new NotSaved({ cause: said })
        const next = try mapError(decodeState(said), unreached)
        return [next, parseState(next)!] as const
      })
    }
  })
}

/** This browser's greeter key: made on its first visit and kept in its store (one that cannot keep it makes one per visit). */
effect function visitor() {
  const store = try KeyValueStore.KeyValueStore
  const kept = store.get(VISITOR) catch () => undefined
  if (kept) return kept
  const made = `visitor-${(try Random.nextInt).toString(36)}${(try Random.nextInt).toString(36)}`
  store.set(VISITOR, made) catch () => undefined
  return made
}

/**
 * `remote` of this visitor's own greeter (spec/app/index.md, "Story: Say hello"): `key` where the page's address names
 * one (`?key=`, as a simulated person's does, so its oracle reads only what that person did), else this browser's.
 */
export function visiting(base: string, key: string | null) {
  return Layer.unwrap(effect { return remote(base, key ?? (try visitor())) })
}
