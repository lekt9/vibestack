{
  "subdomain": "lewis-6d8",
  "branches": {
    "staging": "staging",
    "release": "release/",
    "main": "main"
  },
  "workers": [
    {
      "name": "app",
      "envs": {
        "staging": {
          "config": "apps/app/wrangler.staging.jsonc"
        },
        "preprod": {
          "config": "apps/app/wrangler.preprod.jsonc"
        },
        "production": {
          "config": "apps/app/wrangler.jsonc"
        },
        "preview": {
          "from": "staging"
        }
      },
      "soak": {
        "minRequests": 50
      }
    }
  ],
  "checks": [
    {
      "layer": "unit",
      "name": "the spec: every stage of spec check, no rule unproved (review waits only for a release)",
      "cmd": "node .deploy/vibestack.mjs check",
      "marker": "VIBESTACK_OK",
      "timeout_s": 3600
    },
    {
      "layer": "static",
      "name": "pnpm verify: build, types, tests, browser tests, lint, Knip, Madge and the selftest of every package",
      "cmd": "pnpm verify",
      "timeout_s": 3600
    },
    {
      "layer": "unit",
      "name": "every story is a simulated person",
      "cmd": "node .deploy/vibestack.mjs train --check",
      "marker": "TRAIN_OK"
    },
    {
      "layer": "unit",
      "name": "the scenarios are sound",
      "cmd": "node .deploy/sim.mjs validate",
      "marker": "SIM_VALIDATE_OK"
    }
  ],
  "before": {
    "preprod": [
      {
        "name": "the spec is signed off and every rule proved",
        "cmd": "node .deploy/vibestack.mjs check",
        "marker": "VIBESTACK_OK",
        "timeout_s": 3600
      }
    ],
    "production": [
      {
        "name": "the spec is signed off and every rule proved",
        "cmd": "node .deploy/vibestack.mjs check",
        "marker": "VIBESTACK_OK",
        "timeout_s": 3600
      }
    ]
  },
  "gates": {
    "preview": [
      {
        "name": "conformance on the deployed Worker",
        "cmd": "node .deploy/vibestack.mjs check --worker app",
        "marker": "VIBESTACK_OK",
        "timeout_s": 3600
      },
      {
        "name": "journeys on the deployed Worker",
        "cmd": "DEPLOY_URL=\"$DEPLOY_URL_APP\" pnpm -C apps/app exec vitest run test/app.test.vibe"
      },
      {
        "name": "simulated people",
        "cmd": "node .deploy/sim.mjs run --env preview",
        "marker": "SIM_OK",
        "timeout_s": 1800
      }
    ],
    "staging": [
      {
        "name": "conformance on the deployed Worker",
        "cmd": "node .deploy/vibestack.mjs check --worker app",
        "marker": "VIBESTACK_OK",
        "timeout_s": 3600
      },
      {
        "name": "journeys on the deployed Worker",
        "cmd": "DEPLOY_URL=\"$DEPLOY_URL_APP\" pnpm -C apps/app exec vitest run test/app.test.vibe"
      },
      {
        "name": "simulated people",
        "cmd": "node .deploy/sim.mjs run --env staging",
        "marker": "SIM_OK",
        "timeout_s": 1800
      }
    ],
    "preprod": [
      {
        "name": "conformance on the deployed Worker",
        "cmd": "node .deploy/vibestack.mjs check --worker app",
        "marker": "VIBESTACK_OK",
        "timeout_s": 3600
      },
      {
        "name": "journeys on the deployed Worker",
        "cmd": "DEPLOY_URL=\"$DEPLOY_URL_APP\" pnpm -C apps/app exec vitest run test/app.test.vibe"
      },
      {
        "name": "simulated people",
        "cmd": "node .deploy/sim.mjs run --env preprod",
        "marker": "SIM_OK",
        "timeout_s": 1800
      }
    ],
    "production": [
      {
        "name": "the page answers and the greeter holds a state the spec allows",
        "cmd": "node vibestack/spec.ts observe app \"$DEPLOY_URL_APP\"",
        "marker": "OBSERVED app"
      }
    ]
  },
  "watch": {
    "production": [
      {
        "name": "the page answers and the greeter holds a state the spec allows",
        "cmd": "node vibestack/spec.ts observe app \"$DEPLOY_URL_APP\"",
        "marker": "OBSERVED app"
      }
    ]
  },
  "soak": {
    "hours": 6,
    "minRequests": 50,
    "maxErrorRate": 0.01
  },
  "surfaces": [
    {
      "name": "app",
      "kind": [
        "http",
        "pages",
        "durable-object"
      ],
      "what": "the greeter: its page, its HTTP API at /api/app/<key>, and a Durable Object per greeter",
      "spec": "spec/app/index.md",
      "worker": "app",
      "unit": [
        "the spec: every stage of spec check, no rule unproved (review waits only for a release)",
        "pnpm verify: build, types, tests, browser tests, lint, Knip, Madge and the selftest of every package"
      ],
      "e2e": [
        "conformance on the deployed Worker",
        "journeys on the deployed Worker"
      ],
      "user": [
        "app-say-hello"
      ]
    }
  ],
  "sims": {
    "dir": ".deploy/sims",
    "envs": [
      "preview",
      "staging",
      "preprod"
    ],
    "agent": {
      "servers": {
        "browser": {
          "command": "./node_modules/.bin/playwright",
          "args": [
            "mcp",
            "--headless",
            "--isolated",
            "--browser",
            "chromium"
          ]
        }
      }
    }
  }
}
